{
  "name": "@spetex/figma-design-pipeline",
  "version": "0.8.2",
  "description": "AI design assistant MCP server: inspect Figma designs, plan changes, extract tokens, sync design systems, and generate code. Includes a high-performance Figma plugin for 30-60x faster writes than use_figma.",
  "keywords": [
    "figma",
    "mcp",
    "model-context-protocol",
    "design-assistant",
    "design-to-code",
    "design-system",
    "token-sync",
    "claude",
    "codex",
    "gemini"
  ],
  "homepage": "https://spetex.github.io/figma-design-pipeline/",
  "bugs": {
    "url": "https://github.com/spetex/figma-design-pipeline/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spetex/figma-design-pipeline.git"
  },
  "author": "Petr Sahula",
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "ajv": "^8.18.0"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "directories": {
    "bin": "bin"
  },
  "bin": {
    "spetex-figma-design-pipeline": "bin/spetex-figma-design-pipeline",
    "spetex-figma-design-pipeline-install": "bin/spetex-figma-design-pipeline-install",
    "spfr-figma-design-pipeline": "bin/spfr-figma-design-pipeline",
    "spfr-figma-design-pipeline-install": "bin/spfr-figma-design-pipeline-install"
  },
  "files": [
    "bin",
    "dist/index.js",
    "plugin/dist",
    "scripts/build-server.mjs",
    "scripts/build-plugin.mjs",
    "scripts/install.mjs",
    "skill",
    "CHANGELOG.md",
    "INSTALL.md",
    "PUBLISHING.md",
    "README.md",
    "USAGE.md"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "npm run build:server && npm run build:plugin",
    "build:server": "node scripts/build-server.mjs",
    "build:plugin": "node scripts/build-plugin.mjs",
    "check": "npm run check:src && npm run check:scripts",
    "check:src": "tsc --noEmit -p tsconfig.json",
    "check:scripts": "tsc -p tsconfig.scripts.json",
    "test": "vitest run --passWithNoTests",
    "install:clients": "node scripts/install.mjs",
    "prepack": "npm run build",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^17.4.2",
    "jpeg-js": "0.4.4",
    "modern-gif": "2.1.0",
    "re2js": "^2.8.6",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@figma/plugin-typings": "^1.131.0",
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
